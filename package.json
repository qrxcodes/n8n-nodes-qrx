{
	"name": "n8n-nodes-qrx",
	"version": "0.1.0",
	"description": "n8n node for QRX: create art QR codes that scan, get and list them, and change where they point.",
	"license": "MIT",
	"homepage": "https://github.com/qrxcodes/n8n-nodes-qrx#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"qrx",
		"qr-code",
		"qr-code-generator"
	],
	"author": {
		"name": "QRX",
		"email": "hello@qrx.codes",
		"url": "https://qrx.codes"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qrxcodes/n8n-nodes-qrx.git"
	},
	"bugs": {
		"url": "https://github.com/qrxcodes/n8n-nodes-qrx/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/qrx.test.js test/trigger-and-credential.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/QrxApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Qrx/Qrx.node.js",
			"dist/nodes/QrxTrigger/QrxTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.51.4",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.42.3",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
